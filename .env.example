# 到 Supabase 專案的 Connect → ORM → Prisma 分頁拿這兩行,貼到你本機的 .env(不要提交 .env 本身)
# 兩個 [YOUR-PASSWORD] 都要換成建立專案時的資料庫密碼

# 給 app 執行期查詢用(走 pgbouncer 連線池,6543 埠)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 給 prisma migrate 用的直連(5432 埠,不走連線池)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Google Apps Script 網頁應用程式網址,週報 PDF 靠它寫進 Drive(見 DRIVE-UPLOAD-SETUP.md)
# 部署 Apps Script 專案(執行身分:我,存取權:任何人)後,把 /exec 結尾的網址貼在這裡
GAS_DRIVE_UPLOAD_URL="[YOUR-APPS-SCRIPT-WEB-APP-URL]"

# 跟 Apps Script 程式碼裡 SHARED_SECRET 常數要填一樣的值,避免網址外流被亂上傳
GAS_SHARED_SECRET="[YOUR-RANDOM-SECRET-STRING]"
